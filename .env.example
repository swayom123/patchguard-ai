PATCHGUARD_ENVIRONMENT=development
PATCHGUARD_DATABASE_URL=sqlite:///./patchguard.db
# Colon-separated absolute roots containing repositories PatchGuard may inspect.
PATCHGUARD_ALLOWED_REPOSITORY_ROOTS=/home/user/authorized-repositories
PATCHGUARD_LOG_LEVEL=INFO
PATCHGUARD_LOG_JSON=true
PATCHGUARD_SCAN_MODE=real
PATCHGUARD_READ_ONLY=true
# Optional in development; required in production and for non-loopback binds.
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PATCHGUARD_API_AUTH_TOKEN=replace-with-generated-random-token
PATCHGUARD_MAX_INDEX_FILES=10000
PATCHGUARD_MAX_SOURCE_FILE_BYTES=1000000
PATCHGUARD_SCANNER_TIMEOUT_SECONDS=120
PATCHGUARD_SCANNER_OUTPUT_LIMIT_BYTES=5000000
# Optional reviewed local JSON advisory snapshot; never fetched at runtime.
# PATCHGUARD_ADVISORY_DATABASE_PATH=/etc/patchguard/advisories.json
PATCHGUARD_ADVISORY_MAX_AGE_DAYS=30
# Optional reviewed local image tags. PatchGuard never pulls them automatically.
# PATCHGUARD_BANDIT_IMAGE=your-registry/bandit@sha256:...
# PATCHGUARD_SEMGREP_IMAGE=your-registry/semgrep@sha256:...
# PATCHGUARD_PIP_AUDIT_IMAGE=your-registry/pip-audit@sha256:...
# Required to enable secret scanning. It is never logged or exposed by the API.
# PATCHGUARD_SECRET_FINGERPRINT_KEY=replace-with-a-service-secret
# Optional OpenAI-compatible analysis endpoint; it receives bounded evidence context only.
# PATCHGUARD_MODEL_BASE_URL=https://provider.example/v1
# PATCHGUARD_MODEL_API_KEY=replace-with-provider-secret
# PATCHGUARD_MODEL_NAME=your-reviewed-model
